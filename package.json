{
  "name": "bio-model-project-static",
  "version": "1.0.0",
  "description": "An interactive web-based 3D model of Earth's Carbon Cycle comparing primitive and present-day Earth, photosynthesis, and cellular respiration.",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "prepare": "husky",
    "husky:init": "chmod +x .husky/pre-commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkorpionG/Bio-model-project-static.git"
  },
  "keywords": [
    "biology",
    "carbon-cycle",
    "3d-model",
    "photosynthesis",
    "cellular-respiration"
  ],
  "author": "SkorpionG",
  "bugs": {
    "url": "https://github.com/SkorpionG/Bio-model-project-static/issues"
  },
  "homepage": "https://github.com/SkorpionG/Bio-model-project-static#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1"
  }
}
